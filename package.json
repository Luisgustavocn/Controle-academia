{
  "name": "controle-academia-saas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:fast": "next dev --turbo",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "jobs:backup": "tsx scripts/run-backup.ts",
    "jobs:backup-prune": "tsx scripts/run-prune-json-backups.ts",
    "jobs:backup-postgres": "bash scripts/backup-postgres.sh",
    "jobs:mensalidades": "tsx scripts/run-generate-monthly.ts",
    "jobs:atrasos": "tsx scripts/run-update-overdue.ts",
    "jobs:fechamento": "tsx scripts/run-close-cash-month.ts",
    "jobs:whatsapp-alertas": "tsx scripts/run-whatsapp-reminders.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "recharts": "^2.15.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "8.0.2"
  }
}
