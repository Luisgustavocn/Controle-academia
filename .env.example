# Obrigatorias
NODE_ENV="production"
DATABASE_URL="postgresql://controle_academia_app:PASSWORD@127.0.0.1:5432/controle_academia"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
APP_DATA_DIR="/var/lib/controle-academia"

# Aplicacao
NEXT_PUBLIC_APP_NAME="Controle Academia"
APP_HOST="127.0.0.1"
PORT="3000"
TZ="America/Sao_Paulo"

# PM2 (opcionais; valores nao sensiveis)
PM2_MAX_MEMORY_RESTART="750M"
PM2_OUT_LOG="/var/log/controle-academia/out.log"
PM2_ERROR_LOG="/var/log/controle-academia/error.log"

# Persistencia (opcionais; derivados de APP_DATA_DIR quando vazios)
UPLOAD_DIR=""
BACKUP_EXPORT_DIR=""
BACKUP_EXPORT_DIR_MIRROR=""
JSON_BACKUP_RETENTION_DAYS="14"

# Backup nativo PostgreSQL (sem senha; use PGPASSFILE com permissao 600)
POSTGRES_BACKUP_DIR="/var/lib/controle-academia/database-backups"
POSTGRES_BACKUP_RETENTION_DAYS="30"
PGHOST="127.0.0.1"
PGPORT="5432"
PGUSER="controle_academia_app"
PGDATABASE="controle_academia"
PGPASSFILE="/var/lib/controle-academia/.pgpass"

# WhatsApp
WHATSAPP_BASE_URL="https://whatsapp-api.example.com"
WHATSAPP_INSTANCE_NAME="example-instance"
WHATSAPP_API_KEY=""
WHATSAPP_COUNTRY_CODE="55"
WHATSAPP_DAYS_BEFORE_DUE="3"
WHATSAPP_TEST_PHONE="5511999999999"
