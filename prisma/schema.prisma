generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FINANCEIRO
  RECEPCAO
  PERSONAL
}

enum AlunoStatus {
  ATIVO
  INATIVO
  CANCELADO
  TRANCADO
}

enum MensalidadeStatus {
  PENDENTE
  PAGO
  ATRASADO
  ISENTO
  PARCIAL
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum DespesaStatus {
  PENDENTE
  PAGO
  PARCIAL
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(RECEPCAO)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auditLogs    AuditLog[]
}

model Modalidade {
  id           String        @id @default(cuid())
  nome         String        @unique
  valorPadrao  Decimal       @db.Decimal(10, 2)
  ativa        Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  alunos       Aluno[]
}

model Aluno {
  id                String               @id @default(cuid())
  nomeCompleto      String
  telefone          String?
  vencimentoDia     Int
  status            AlunoStatus          @default(ATIVO)
  dataInicio        DateTime
  dataSaida         DateTime?
  observacoes       String?
  modalidadeId      String
  modalidade        Modalidade           @relation(fields: [modalidadeId], references: [id])
  mensalidades      Mensalidade[]
  pagamentos        Pagamento[]
  presencas         Presenca[]
  agendaItens       AgendaPersonal[]
  movimentosCaixa   MovimentacaoCaixa[]
  pedidos           PedidoProduto[]
  historicoPlanos   HistoricoPlano[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([nomeCompleto])
  @@index([telefone])
  @@index([status])
}

model HistoricoPlano {
  id                  String     @id @default(cuid())
  alunoId             String
  modalidadeAnterior  String?
  modalidadeNova      String
  valorAnterior       Decimal?   @db.Decimal(10, 2)
  valorNovo           Decimal    @db.Decimal(10, 2)
  motivo              String?
  changedAt           DateTime   @default(now())
  aluno               Aluno      @relation(fields: [alunoId], references: [id])
}

model Mensalidade {
  id              String             @id @default(cuid())
  alunoId         String
  competencia     String
  valor           Decimal            @db.Decimal(10, 2)
  vencimento      DateTime
  dataPagamento   DateTime?
  formaPagamento  String?
  status          MensalidadeStatus  @default(PENDENTE)
  observacao      String?
  aluno           Aluno              @relation(fields: [alunoId], references: [id])
  pagamentos      Pagamento[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([alunoId, competencia])
  @@index([competencia])
  @@index([status])
}

model Pagamento {
  id              String       @id @default(cuid())
  alunoId         String
  mensalidadeId   String?
  data            DateTime
  valor           Decimal      @db.Decimal(10, 2)
  formaPagamento  String
  observacao      String?
  aluno           Aluno        @relation(fields: [alunoId], references: [id])
  mensalidade     Mensalidade? @relation(fields: [mensalidadeId], references: [id])
  createdAt       DateTime     @default(now())
}

model CategoriaFinanceira {
  id            String              @id @default(cuid())
  nome          String              @unique
  tipo          TipoMovimentacao
  ativa         Boolean             @default(true)
  movimentacoes MovimentacaoCaixa[]
}

model MovimentacaoCaixa {
  id                String               @id @default(cuid())
  data              DateTime
  tipo              TipoMovimentacao
  categoriaId       String?
  categoria         CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])
  descricao         String
  valor             Decimal              @db.Decimal(10, 2)
  origemDestino     String?
  alunoId           String?
  aluno             Aluno?               @relation(fields: [alunoId], references: [id])
  formaPagamento    String?
  competencia       String
  observacao        String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([competencia])
}

model DespesaAcademia {
  id               String         @id @default(cuid())
  dataVencimento   DateTime
  competencia      String
  descricao        String
  categoria        String
  valorPrevisto    Decimal        @db.Decimal(10, 2)
  valorPago        Decimal        @default(0) @db.Decimal(10, 2)
  status           DespesaStatus  @default(PENDENTE)
  dataPagamento    DateTime?
  observacao       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([competencia])
  @@index([categoria])
}

model DespesaFamilia {
  id               String         @id @default(cuid())
  dataVencimento   DateTime
  competencia      String
  descricao        String
  categoria        String
  valorPrevisto    Decimal        @db.Decimal(10, 2)
  valorPago        Decimal        @default(0) @db.Decimal(10, 2)
  status           DespesaStatus  @default(PENDENTE)
  dataPagamento    DateTime?
  observacao       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([competencia])
  @@index([categoria])
}

model Presenca {
  id             String    @id @default(cuid())
  alunoId        String
  data           DateTime
  horario        String?
  tipoAula       String
  presente       Boolean   @default(true)
  observacao     String?
  aluno          Aluno     @relation(fields: [alunoId], references: [id])

  @@unique([alunoId, data, tipoAula])
  @@index([data])
}

model AgendaPersonal {
  id            String    @id @default(cuid())
  professor     String
  diaSemana     Int
  horario       String
  alunoId       String?
  alunoNome     String?
  tipoAula      String
  observacao    String?
  ativo         Boolean   @default(true)
  aluno         Aluno?    @relation(fields: [alunoId], references: [id])

  @@index([professor, diaSemana])
}

model Produto {
  id            String          @id @default(cuid())
  nome          String
  categoria     String
  tamanho       String?
  cor           String?
  preco         Decimal         @db.Decimal(10, 2)
  estoque       Int             @default(0)
  ativo         Boolean         @default(true)
  pedidoItens   PedidoItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([nome])
}

model PedidoProduto {
  id            String       @id @default(cuid())
  clienteNome   String
  alunoId       String?
  aluno         Aluno?       @relation(fields: [alunoId], references: [id])
  valorTotal    Decimal      @default(0) @db.Decimal(10, 2)
  valorPago     Decimal      @default(0) @db.Decimal(10, 2)
  pago          Boolean      @default(false)
  dataPedido    DateTime
  observacao    String?
  itens         PedidoItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model PedidoItem {
  id             String          @id @default(cuid())
  pedidoId       String
  produtoId      String?
  modelo         String?
  cor            String?
  tamanho        String?
  quantidade     Int
  valorUnitario  Decimal         @db.Decimal(10, 2)
  valorTotal     Decimal         @db.Decimal(10, 2)
  pedido         PedidoProduto   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto        Produto?        @relation(fields: [produtoId], references: [id])
}

model Configuracao {
  id            String   @id @default(cuid())
  chave         String   @unique
  valor         String
  updatedAt     DateTime @updatedAt
}

model FechamentoMensal {
  id                String    @id @default(cuid())
  competencia       String    @unique
  inicioMes         Int
  entrou            Int
  saiu              Int
  totalFinal        Int
  ajusteManual      Boolean   @default(false)
  observacao        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  entidade       String
  entidadeId     String
  acao           String
  dadosAntes     Json?
  dadosDepois    Json?
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])

  @@index([entidade, entidadeId])
}
